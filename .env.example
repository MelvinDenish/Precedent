# ─── Database ────────────────────────────────────────────────
# Local docker-compose default. On AWS, point at RDS or Neon.
DATABASE_URL=postgres://precedent:precedent@localhost:5432/precedent

# ─── Redis (BullMQ) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────
# REQUIRED. No hardcoded fallback exists; the API refuses to boot without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── LLM providers ───────────────────────────────────────────
# Gemini: vision extraction (PRIMARY PATH - most corpus papers are scans)
#         plus bulk structured calls. Free tier ~1500 req/day.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# Groq: Tutor Chat only. Token latency is what makes a tutor feel alive.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Set to 'mock' to run the whole pipeline with a deterministic fake provider:
# no keys, no network, reproducible output. Used by the test suite.
LLM_PROVIDER_MODE=live

# ─── Embeddings (local ONNX, no network, no cost) ────────────
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384
MODEL_CACHE_DIR=./.models

# ─── Blob storage ────────────────────────────────────────────
# 'local' writes under BLOB_LOCAL_DIR; 's3' uses the AWS vars below.
BLOB_DRIVER=local
BLOB_LOCAL_DIR=./.blobs
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# CORS is restricted to this origin. No wildcard in production.
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ─── Worker ──────────────────────────────────────────────────
WORKER_CONCURRENCY_INGEST=2
WORKER_CONCURRENCY_EMBED=8
WORKER_CONCURRENCY_ADJUDICATE=4
WORKER_CONCURRENCY_ENRICH=2
WORKER_CONCURRENCY_GENERATE=2

# ─── Corpus seeding ──────────────────────────────────────────
# Local path to the (gitignored) corpus. Never committed.
CORPUS_DIR=./data
